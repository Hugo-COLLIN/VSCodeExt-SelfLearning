{
  "name": "2-jokes",
  "displayName": "2-jokes",
  "description": "from https://youtu.be/cj-Q6_k5gSM",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.111.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": [
      {
        "title": "jokes",
        "properties": {
          "greetings": {
            "type": "string",
            "description": "Your greetings!",
            "default": "Bonjour"
          }
        }
      }
    ],
    "commands": [
      {
        "command": "2-jokes.helloWorld",
        "title": "Get a Joke!"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.120.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "axios": "^1.17.0",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
